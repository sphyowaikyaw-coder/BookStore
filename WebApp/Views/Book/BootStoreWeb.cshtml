@model List<WebApp.View_Model.VM_TbBook>

@{
    Layout = "BackGround";
}

<!DOCTYPE html>
    <html>
    <head>
        <title></title>
    </head>
    <body>
    @section Slider{
        <div class="owl-carousel owl-theme hero-slider">
            
                   
    @foreach (var book in Model)
    {
