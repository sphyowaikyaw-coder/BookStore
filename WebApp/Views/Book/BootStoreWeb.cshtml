                    <div class="container">
                        <div class="row">
            
                            <div class="col-12 text-center text-white">
                                <h6 class="text-white text-uppercase"></h6>
                                <h1 class="display-3 my-4">@book.BookName<br />@book.BookAuthur</h1>
                                <a href="#" class="btn btn-brand">Get</a>
                                <a href="#" class="btn btn-outline-light ms-3">View</a>
                            </div>
                        </div>
                    </div>
                </div>
        }
                   
               

        </div>
    }
@section Milestone{
        <section id="milestone">
            <div class="container">
                <div class="row text-center justify-content-center gy-4">
                    <div class="col-lg-2 col-sm-6">
                        <h1 class="display-4">
                            @Model.Count+
                        </h1>
                        <p class="mb-0">Books</p>
                    </div>
