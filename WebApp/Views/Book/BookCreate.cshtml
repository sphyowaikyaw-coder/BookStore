@model WebApp.View_Model.VM_TbBook;

@{
    ViewData["Title"] = "Add Book";
}
@{
    Layout = "BackGround";
}
@* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"> *@

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2 class="text-center mb-4">Add Book</h2>

        <form method="post" enctype="multipart/form-data" asp-controller="Book" asp-action="BookCreate">

            <!-- Book Name -->
            <div class="mb-3">
                <label class="form-label">Book Name</label>
                <input type="text" name="BookName" class="form-control" placeholder="Enter book name" />
            </div>

            <!-- Author -->
            <div class="mb-3">
                <label class="form-label">Author</label>
                <input type="text" name="BookAuthur" class="form-control" placeholder="Enter author name" />
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input type="number" step="0.01" name="Price" class="form-control" placeholder="Enter price" />
            </div>

            <!-- Release Date -->
            <div class="mb-3">
                <label class="form-label">Release Date</label>
                <input type="date" name="ReleaveDate" class="form-control" />
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="Description" rows="4" class="form-control" placeholder="Enter description"></textarea>
            </div>

            <!-- Book Cover -->
            <div class="mb-3">
                <label class="form-label">Book Cover</label>
                <input type="file" name="BookCoverFile" class="form-control" />
            </div>

            <!-- Button -->
            <div class="text-center">
                <button type="submit" class="btn btn-primary px-4">
                    Save Book
                </button>
            </div>

        </form>
    </div>
</div>
