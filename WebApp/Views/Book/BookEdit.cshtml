@model WebApp.View_Model.VM_TbBook;

@{
    ViewData["Title"] = "Add Book";
}
@{
    Layout = "BackGround";
}
@* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"> *@

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2 class="text-center mb-4">Edit Book</h2>

        <form method="post" enctype="multipart/form-data" asp-controller="Book" asp-action="BookEdit">

            <input type="hidden" asp-for="BookId" />
            <!-- Book Name -->
            <div class="mb-3">
                <label class="form-label">Book Name</label>
                <input type="text" asp-for="BookName" name="BookName" class="form-control" placeholder="Enter book name" />
            </div>

            <!-- Author -->
            <div class="mb-3">
                <label class="form-label">Author</label>
                <input type="text" asp-for="BookAuthur" name="BookAuthur" class="form-control" placeholder="Enter author name" />
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input type="number" step="0.01" name="Price" class="form-control" placeholder="Enter price" asp-for="Price" />
            </div>

            <!-- Release Date -->
            <div class="mb-3">
                <label class="form-label">Release Date</label>
                <input type="date" name="ReleaveDate" class="form-control" asp-for="ReleaveDate" />
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="Description" rows="4" class="form-control" placeholder="Enter description" asp-for="Description"></textarea>
            </div>

            <!-- Book Cover -->
            <div class="mb-3">
                <label class="form-label">Book Cover</label>
                <div>
                    <img src="@Model.BookCover"
                         alt="Book Cover"
                         class="book-cover mb-2">
                    
                    <input type="file" name="BookCoverFile" class="form-control" asp-for="BookCoverFile" />

                </div>
                
            </div>

            <!-- Button -->
            <div class="text-center">
                <button type="submit" class="btn btn-primary px-4">
                    Save Book
                </button>
            </div>

        </form>
    </div>
</div>
