@model List<WebApp.View_Model.VM_TbBook>

@{
    Layout = "My_Layout";
}

<!DOCTYPE html>
<html>
<head>
    <title>Book Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>

        body {
            background: #f4f7fc;
        }

        .main-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .page-title {
            font-weight: 700;
            color: #1e293b;
        }

        .table thead th {
            background: #2563eb;
            color: white;
            border: none;
            padding: 15px;
            font-size: 15px;
        }

        .table tbody td {
            vertical-align: middle;
            padding: 15px;
        }

        .table tbody tr {
            transition: 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: #f1f5ff;
                transform: scale(1.002);
            }

        .book-cover {
            width: 80px;
            height: 100px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
        }

        .btn-custom {
            border-radius: 10px;
            font-weight: 500;
        }

        .description-box {
            max-width: 220px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .empty-box {
            padding: 50px;
            text-align: center;
            color: gray;
        }

        @@media(max-width:768px) {

            .header-section {
                flex-direction: column;
                align-items: stretch;
            }

            .header-buttons {
                width: 100%;
                display: flex;
                gap: 10px;
            }

                .header-buttons a,
                .header-buttons button {
                    width: 100%;
                }
        }

    </style>

</head>

<body>

    <div class="container mt-5 mb-5">

        <div class="card main-card">

            <div class="card-body p-4">

                <!-- Header -->
                <div class="header-section mb-4">

                    <div>
                        <h2 class="page-title mb-1">
                            <i class="fa-solid fa-book"></i>
                            Book Management
                        </h2>

                        <p class="text-muted mb-0">
                            Manage your books easily
                        </p>
                    </div>

                    <div class="header-buttons d-flex gap-2">

                        <form asp-controller="Book"
                              asp-action="BookLists"
                              method="get">

                            <button class="btn btn-outline-primary btn-custom"
                                    type="submit">

                                <i class="fa-solid fa-rotate"></i>
                                Refresh
                            </button>

                        </form>

                        <a asp-controller="Book"
                           asp-action="BookCreateView"
                           class="btn btn-primary btn-custom">

                            <i class="fa-solid fa-plus"></i>
                            Add Book

                        </a>

                    </div>

                </div>
                <form style="width: 100%;" class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search" method="get" asp-controller="Book" asp-action="SearchBooks">
                    <div class="input-group">
                        <input type="text" style="width: 75%;" name="keyword" class="form-control bg-light border-0 small" placeholder="Search for..."
                               aria-label="Search" aria-describedby="basic-addon2">
                        <div class="input-group-append">
                            <button class="btn btn-primary" style="width: 70px;" type="submit">
                                <i class="fas fa-search fa-sm"></i>
                            </button>
                        </div>
                    </div>
                </form>
                <div><br /></div>
                <!-- Table -->
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>No.</th>
                                <th>Cover</th>
                                <th>Book Name</th>
                                <th>Author</th>
                                <th>Price</th>
                                <th>Release Date</th>
                                <th>Description</th>
                                <th width="170">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Count > 0)
                            {
                                int i = 1;

                                @foreach (var book in Model)
                                {
                                    <tr>

                                        <td class="fw-bold">
                                            @i
                                        </td>

                                        <td>
                                            <img src="@book.BookCover"
                                                 alt="Book Cover"
                                                 class="book-cover" />
                                        </td>

                                        <td class="fw-semibold">
                                            @book.BookName
                                        </td>

                                        <td>
                                            @book.BookAuthur
                                        </td>

                                        <td class="text-success fw-bold">
                                            @book.Price
                                        </td>

                                        <td>
                                            @book.ReleaveDate
                                        </td>

                                        <td>
                                            <div class="description-box"
                                                 title="@book.Description">

                                                @book.Description

                                            </div>
                                        </td>

                                        <td>

                                           
                                                <div class="d-flex flex-column gap-2">

                                                    <a asp-controller="Book"
                                                       asp-action="BookEditView"
                                                       asp-route-id="@book.BookId"
                                                       class="btn btn-warning btn-sm btn-custom">

                                                        <i class="fa-solid fa-pen-to-square"></i>
                                                        Edit

                                                    </a>

                                                    <form asp-action="DeleteBook" asp-controller="Book" method="post">
                                                        <input type="hidden" name="id" value="@book.BookId" />
                                                        <button type="submit" class="btn btn-danger"
                                        >Delete</button>
                                                    </form>

                                                </div>

                                        </td>

                                    </tr>

                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8">

                                        <div class="empty-box">

                                            <i class="fa-solid fa-book-open fa-3x mb-3"></i>

                                            <h5>No Books Found</h5>

                                        </div>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</body>
</html>